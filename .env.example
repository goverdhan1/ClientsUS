# Gmail SMTP. You need an APP PASSWORD (2-Step Verification must be on):
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=goverdhan.c@gmail.com
SMTP_APP_PASSWORD=replace-with-16-char-app-password

# Sender identity. CAN-SPAM requires your real name and a real postal address
# in every commercial email.
SENDER_NAME=Your Name
SENDER_COMPANY=Your Company LLC
SENDER_POSTAL_ADDRESS=123 Main St, Suite 4, Austin, TX 78701

# Sending limits (Gmail free accounts cap around 500/day; stay well under)
MAX_PER_RUN=50
PER_STATE_CAP=5
COOLDOWN_DAYS=30
# Pause between individual sends; kinder to Gmail's throttling. 0 disables.
SEND_DELAY_SECONDS=3

# Optional: free keys for public RFP discovery
# SAM_GOV_API_KEY=     (https://open.gsa.gov/api/get-opportunities-public-api/)
# DATAGOV_API_KEY=     (https://api.gsa.gov)
